# Copy this file to .env and set both secrets before enabling catalog uploads.
# Use a unique password of at least 12 characters.
KODA_ADMIN_PASSWORD=
# Use a random secret of at least 32 characters (example: openssl rand -hex 32).
KODA_SESSION_SECRET=

# Google OAuth 2.0 Credentials (Optional - configured in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Connection (PostgreSQL - Supabase / Neon / Render Postgres / Railway)
# Example: postgresql://postgres:password@localhost:5432/koda?schema=public
DATABASE_URL=

# Multi-Node Cluster Scaling & Real-time Pub/Sub (Redis)
# Example: redis://localhost:6379 or rediss://default:password@upstash.io:6379
REDIS_URL=

# Transactional Email Delivery (Resend API)
# Get an API key at https://resend.com
RESEND_API_KEY=
FROM_EMAIL="KODA Studio <noreply@koda.fm>"

# Cloud Audio Storage & Global CDN (Cloudflare R2 / AWS S3)
# Zero-egress bandwidth streaming: Cloudflare R2 is recommended
R2_ACCOUNT_ID=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
# Optional custom CDN domain (e.g., https://cdn.koda-studio.com or https://pub-xxxx.r2.dev)
S3_PUBLIC_DOMAIN=

PORT=3000
# Optional verified domains for CORS (comma-separated, e.g. https://koda.studio,https://mykoda.onrender.com)
# When unset, local development (localhost, 127.0.0.1) and same-host requests are permitted.
ALLOWED_ORIGINS=http://localhost:3000

# Optional custom storage locations; relative paths resolve from the project directory.
KODA_DATA_DIR=./data
KODA_UPLOADS_DIR=./uploads

# Legal, Compliance & DMCA Protection
DMCA_AGENT_EMAIL=dmca@koda.fm
DMCA_AGENT_NAME="KODA Copyright Compliance Agent"
COMPANY_NAME="KODA Studio Inc."
CONTACT_EMAIL=support@koda.fm

# Monetization & Subscriptions (Stripe Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
